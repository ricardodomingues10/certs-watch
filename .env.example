# Copiar para .env e ajustar. Segredos NÃO vão aqui (ficam em ./secrets/).

# Base de dados (o compose publica o PostgreSQL em 127.0.0.1:55432)
CERTWATCH_DB_HOST=127.0.0.1
CERTWATCH_DB_PORT=55432
CERTWATCH_DB_NAME=certwatch
CERTWATCH_DB_USER=certwatch

# UCMDB
# Obrigatórios: valores reais só neste ficheiro .env do servidor (não vai para o Git)
CERTWATCH_UCMDB_URL=https://cmdb.exemplo.local:8443
CERTWATCH_UCMDB_TQL=NOME_DO_TQL_DE_CERTIFICADOS
CERTWATCH_UCMDB_CLIENT_CONTEXT=1
# Lista de APIs na UCMDB (opcional). Deixar vazio para desativar.
# Os campos são detetados automaticamente; só definir se a deteção errar (ver página APIs ou
# "python -m certwatch.cli inspect-tql NOME_DO_TQL" para os nomes internos dos atributos).
CERTWATCH_UCMDB_TQL_APIS=
CERTWATCH_APIS_FIELD_NAME=
CERTWATCH_APIS_FIELD_APP=
CERTWATCH_APIS_FIELD_EXPIRY=
CERTWATCH_APIS_FIELD_EXPIRED=
CERTWATCH_APIS_FIELD_LOCATION=
CERTWATCH_APIS_FIELD_REGISTERED=
CERTWATCH_APIS_FIELD_URL=
# Se o layout do TQL só trouxer o nome: auto (consulta ad-hoc, senão CI a CI) | query | ci | off
CERTWATCH_APIS_ENRICH=auto
# Alternativa sem REST: exportação da lista gravada em import/api-cmdb.csv (prefixo do ficheiro)
CERTWATCH_APIS_FILE=api-cmdb

# Procura de certificados na internet (Certificate Transparency). Vazio = desativado.
# O servidor precisa de saída HTTPS para crt.sh, api.certspotter.com e api.ctlogs.dev.
# Se sair por proxy: HTTPS_PROXY=http://proxy:porta (e NO_PROXY para os endereços internos).
# Vários domínios separados por vírgulas (ex.: exemplo.pt,exemplo.com,exemplo.org). Inclui todos os subdomínios.
CERTWATCH_CT_DOMAINS=
CERTWATCH_CT_SOURCES=crtsh,certspotter,ctlogs
# A aplicação verifica os nomes encontrados (para saber que certificado cada site serve, ex.: wildcards).
# Os que não respondem são desligados sem alerta. false para não verificar.
CERTWATCH_CT_SCAN=true
CERTWATCH_CT_SCAN_MAX=500
# Chaves opcionais (aumentam os limites): segredos certspotter_api_key e ctlogs_api_key

# SMAX (opcional, só leitura de tickets). Segredos: secrets/smax_user e secrets/smax_password
# (se não usar o SMAX, criar os dois ficheiros vazios: touch secrets/smax_user secrets/smax_password)
CERTWATCH_SMAX_URL=
CERTWATCH_SMAX_TENANT=
CERTWATCH_SMAX_ENTITY=Change
# Filtro SMAX para os pedidos de certificados, ex.: BasedOnChangeModel='123456'
CERTWATCH_SMAX_FILTER=
# Campos personalizados (UserOptions) com o endpoint, a data de expiração (ms), o ambiente e o tipo
CERTWATCH_SMAX_FIELD_ENDPOINT=Endpoint_c
CERTWATCH_SMAX_FIELD_EXPIRY=DataExpiracao_c
CERTWATCH_SMAX_FIELD_ENV=Ambiente_c
CERTWATCH_SMAX_FIELD_TYPE=TipoCertificado_c
# Fases consideradas fechadas; as restantes contam como pedido em curso
CERTWATCH_SMAX_CLOSED_PHASES=Close,Closed,Abandon,Abandoned,Done
# Link para abrir um pedido ({base}, {tenant}, {entity}, {id})
CERTWATCH_SMAX_TICKET_URL={base}/saw/{entity}/{id}/general?TENANTID={tenant}
# Comentários dos pedidos abertos (collaboration/comments) e link para a discussão
CERTWATCH_SMAX_COMMENTS=true
CERTWATCH_SMAX_COMMENTS_MAX=300
CERTWATCH_SMAX_DISCUSSIONS_URL={base}/saw/{entity}/{id}/discussions?TENANTID={tenant}

# SMAX: criação de pedidos de renovação (desligada por omissão). Valores do vosso modelo de change.
CERTWATCH_SMAX_CREATE_ENABLED=false
# Modelo de change (BasedOnChangeModel) e serviço afetado (AffectsActualService): números
CERTWATCH_SMAX_CHANGE_MODEL=
CERTWATCH_SMAX_SERVICE=
# Domínios de dados (DataDomains), separados por vírgulas
CERTWATCH_SMAX_DATA_DOMAINS=
# Valores sugeridos quando não há histórico: Application ID (AffectsServiceComponent) e responsabilidade de instalação
CERTWATCH_SMAX_DEFAULT_APP_ID=
CERTWATCH_SMAX_DEFAULT_RESPONSIBLE=
# Ambientes aceites e o valor da lista no SMAX
CERTWATCH_SMAX_ENV_CODES=DEV=Name1_c;TST=Name2_c;SIT=Name3_c;UAT=Name4_c;PRE=Name5_c;PPRD=Name5_c;PRD=Name6_c
# Tipos de certificado aceites (sem o sufixo _c, que é acrescentado no pedido)
CERTWATCH_SMAX_TYPE_OPTIONS=Interno;Externo
# Máximo de pedidos por lote e assinatura da descrição
CERTWATCH_SMAX_CREATE_MAX=50
CERTWATCH_SMAX_DESCRIPTION_SIGN=Obrigada

# Avaliação externa Qualys SSL Labs (opcional). Registo único com email da organização:
#   docker compose exec worker python -m certwatch.cli ssllabs-register --nome N --apelido A --email E --organizacao O
# Uso gratuito para testar a própria infraestrutura; uso comercial exige autorização da Qualys.
CERTWATCH_SSLLABS_EMAIL=
CERTWATCH_SSLLABS_MAX_HOSTS=25
CERTWATCH_SSLLABS_MAX_AGE_DAYS=7
CERTWATCH_SSLLABS_BUDGET_MIN=30

# Renovação automática: emissores (expressões separadas por ';') e prazo de alerta. 0 = alertar como os outros.
# CERTWATCH_AUTO_RENEW_ISSUERS=let'?s ?encrypt;\bisrg\b;^(cn=)?[re]\d{1,2}$;^(cn=)?y[re]\d{1,2}$
CERTWATCH_AUTO_RENEW_ALERT_DAYS=20

# Reconciliação: diretoria montada em ./import. Prefixo do nome do ficheiro -> fonte
# azure* = exportação de credenciais de App Registrations, comparada com a lista de APIs da CMDB
# CA1=ca1;CA2=ca2;AVI=avi;AZURE=azure já vêm de origem; aqui só fontes extra (ex.: CA3=ca3)
CERTWATCH_IMPORT_SOURCES=
# Emissor de cada CA (quando a exportação não traz a coluna). Ex.: CA1=Nome da CA01;CA2=Nome da CA02
CERTWATCH_IMPORT_ISSUERS=

# Atualizar a CMDB (CMDB_Final.xlsx, certs_update.csv, certs_update_sem_cabecalho.csv). Ver README 5.1
# Os certificados novos de CA1/CA2 levam o emissor de CERTWATCH_IMPORT_ISSUERS (obrigatório para gerar os CSV)
CERTWATCH_FINAL_SOURCES=CA1,CA2,AVI
# Incluir os certificados encontrados na internet (só os marcados "Adicionar à CMDB" vêm incluídos por omissão)
CERTWATCH_FINAL_CT=true
# auto: completa pela REST API os atributos que faltem ao layout do TQL | query | ci | off
CERTWATCH_FINAL_ENRICH=auto
CERTWATCH_FINAL_DESCRIPTION=Changed with n8n
CERTWATCH_FINAL_LIVE_MARKER=Validado via TLS
CERTWATCH_FINAL_LIVE_MAX_AGE_H=24
CERTWATCH_FINAL_KEEP_RUNS=20
# Pasta de rede montada no servidor (caminho no servidor), passada ao container em /app/publicar
CERTWATCH_PUBLISH_HOST_DIR=
# Opcional: grupo com escrita na montagem (quando não é montada com uid=10001)
CERTWATCH_PUBLISH_GID=

# Pedidos SMAX: fechar e reabrir na aplicação (bulk UPDATE). Por omissão segue CERTWATCH_SMAX_CREATE_ENABLED.
# Os campos dependem do modelo de change; se o SMAX pedir mais campos ao fechar, acrescente-os aqui (JSON).
CERTWATCH_SMAX_UPDATE_ENABLED=false
CERTWATCH_SMAX_CLOSE_FIELDS={"PhaseId": "Close"}
CERTWATCH_SMAX_REOPEN_FIELDS={"PhaseId": "Execute"}
# Privacidade do comentário escrito ao fechar/reabrir: INTERNAL ou PUBLIC
CERTWATCH_SMAX_COMMENT_PRIVACY=INTERNAL
# Imagens e anexos novos dos comentários descarregados em cada leitura do SMAX
CERTWATCH_SMAX_FILES_MAX=200

# Relatório por email. A password do SMTP (se houver) vai no segredo secrets/smtp_password
CERTWATCH_SMTP_HOST=
CERTWATCH_SMTP_PORT=25
# starttls | ssl | none
CERTWATCH_SMTP_SECURITY=starttls
CERTWATCH_SMTP_FROM=
CERTWATCH_SMTP_USER=
# Destinatários sugeridos e domínios permitidos (ex.: organizacao.pt)
CERTWATCH_REPORT_TO=
CERTWATCH_REPORT_ALLOWED_DOMAINS=
CERTWATCH_REPORT_SIGNATURE=certwatch
CERTWATCH_REPORT_WINDOW_DAYS=90
CERTWATCH_REPORT_ALERT_DAYS=20

# Classificação interno/externo: sufixos de domínio internos e padrões no nome das CAs internas
CERTWATCH_INTERNAL_SUFFIXES=.local,.lan,.internal,.intranet,.corp
CERTWATCH_INTERNAL_ISSUER_PATTERNS=internal,interna

# Proteção: abaixo deste número a ingestão é abortada (evita desativar registos por engano)
CERTWATCH_UCMDB_MIN_CIS=300
# Manter "true". Só pôr "false" temporariamente enquanto a raiz interna não estiver em ./trust
CERTWATCH_UCMDB_VERIFY_TLS=true

# Scanner
CERTWATCH_SCAN_DEFAULT_PORT=443
CERTWATCH_SCAN_ALLOWED_PORTS=443,465,636,993,995,4443,5986,8443,9443
CERTWATCH_SCAN_TIMEOUT=8
CERTWATCH_SCAN_WORKERS=16
CERTWATCH_UNREACHABLE_AFTER=2

# Limiares de expiração (dias) e % de vida restante que eleva para "media"
CERTWATCH_EXPIRY_CRITICA=7
CERTWATCH_EXPIRY_ALTA=20
CERTWATCH_EXPIRY_MEDIA=30
CERTWATCH_EXPIRY_BAIXA=90
CERTWATCH_LIFETIME_WARN_PCT=0.2

# Agendamento
CERTWATCH_PIPELINE_DAILY_AT=06:15
CERTWATCH_TIMEZONE=Europe/Lisbon

# Interface web
CERTWATCH_ADMIN_USER=admin
CERTWATCH_COOKIE_SECURE=false
