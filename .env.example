# Copiar para .env e ajustar. Segredos NÃO vão aqui (ficam em ./secrets/).

# Base de dados (o compose publica o PostgreSQL em 127.0.0.1:55432)
CERTWATCH_DB_HOST=127.0.0.1
CERTWATCH_DB_PORT=55432
CERTWATCH_DB_NAME=certwatch
CERTWATCH_DB_USER=certwatch

# UCMDB
# Obrigatórios: valores reais só neste ficheiro .env do servidor (não vai para o Git)
CERTWATCH_UCMDB_URL=https://cmdb.exemplo.local:8443
CERTWATCH_UCMDB_TQL=NOME_DO_TQL_DE_CERTIFICADOS
CERTWATCH_UCMDB_CLIENT_CONTEXT=1
# Proteção: abaixo deste número a ingestão é abortada (evita desativar registos por engano)
CERTWATCH_UCMDB_MIN_CIS=300
# Manter "true". Só pôr "false" temporariamente enquanto a raiz interna não estiver em ./trust
CERTWATCH_UCMDB_VERIFY_TLS=true

# Scanner
CERTWATCH_SCAN_DEFAULT_PORT=443
CERTWATCH_SCAN_ALLOWED_PORTS=443,465,636,993,995,4443,5986,8443,9443
CERTWATCH_SCAN_TIMEOUT=8
CERTWATCH_SCAN_WORKERS=16
CERTWATCH_UNREACHABLE_AFTER=2

# Limiares de expiração (dias) e % de vida restante que eleva para "media"
CERTWATCH_EXPIRY_CRITICA=7
CERTWATCH_EXPIRY_ALTA=20
CERTWATCH_EXPIRY_MEDIA=30
CERTWATCH_EXPIRY_BAIXA=90
CERTWATCH_LIFETIME_WARN_PCT=0.2

# Agendamento
CERTWATCH_PIPELINE_DAILY_AT=06:15
CERTWATCH_TIMEZONE=Europe/Lisbon

# Interface web
CERTWATCH_ADMIN_USER=admin
CERTWATCH_COOKIE_SECURE=false
